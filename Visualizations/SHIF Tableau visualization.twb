    <worksheet name='KPIs2'>
      <layout-options>
        <title>
          <formatted-text />
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Claims+ (Tableau must do)' name='federated.1x7bdiv05aksyk1d73glf0mn641h' />
          </datasources>
          <datasource-dependencies datasource='federated.1x7bdiv05aksyk1d73glf0mn641h'>
            <column caption='Age Group' datatype='string' name='[Calculation_906067955668070400]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [age] &gt;= 18 AND [age] &lt;= 25 THEN &quot;18–25&quot;&#13;&#10;ELSEIF [age] &lt;= 35 THEN &quot;26–35&quot;&#13;&#10;ELSEIF [age] &lt;= 45 THEN &quot;36–45&quot;&#13;&#10;ELSEIF [age] &lt;= 55 THEN &quot;46–55&quot;&#13;&#10;ELSEIF [age] &lt;= 65 THEN &quot;56–65&quot;&#13;&#10;ELSE &quot;66-80&quot;&#13;&#10;END' />
            </column>
            <column caption='Approval Rate' datatype='real' name='[Calculation_906067955950080005]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IF [claim_status] = &quot;Approved&quot; THEN 1 ELSE 0 END) / COUNT([claim_id]))* 100' />
            </column>
            <column caption='% Subsidized' datatype='real' name='[Calculation_906067955983216652]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum(if [is_subsidized] = True then 1 else 0 end)/count([member_id (Members)]))' />
            </column>
            <column caption='Average service utilization' datatype='real' name='[Calculation_906067955987329037]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='count([service_type]) / countd([service_type])' />
            </column>
            <column caption='Age' datatype='integer' name='[age]' role='measure' type='quantitative' />
            <column-instance column='[contribution_amount]' derivation='Avg' name='[avg:contribution_amount:qk]' pivot='key' type='quantitative' />
