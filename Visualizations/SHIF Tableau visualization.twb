      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.1x7bdiv05aksyk1d73glf0mn641h].[avg:contribution_amount:qk]&quot;' value='AVG CONTRIBUTIONS' />
          <alias key='&quot;[federated.1x7bdiv05aksyk1d73glf0mn641h].[cnt:member_id (Members):qk]&quot;' value='TOTAL MEMBERS' />
          <alias key='&quot;[federated.1x7bdiv05aksyk1d73glf0mn641h].[usr:Calculation_906067955950080005:qk]&quot;' value='APPROVAL RATE' />
          <alias key='&quot;[federated.1x7bdiv05aksyk1d73glf0mn641h].[usr:Calculation_906067955983216652:qk]&quot;' value='% SUBSIDIZED' />
          <alias key='&quot;[federated.1x7bdiv05aksyk1d73glf0mn641h].[usr:Calculation_906067955987329037:qk]&quot;' value='AVG UTILIZATION' />
        </aliases>
      </column>
      <column caption='Age Group' datatype='string' name='[Calculation_906067955668070400]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [age] &gt;= 18 AND [age] &lt;= 25 THEN &quot;18–25&quot;&#13;&#10;ELSEIF [age] &lt;= 35 THEN &quot;26–35&quot;&#13;&#10;ELSEIF [age] &lt;= 45 THEN &quot;36–45&quot;&#13;&#10;ELSEIF [age] &lt;= 55 THEN &quot;46–55&quot;&#13;&#10;ELSEIF [age] &lt;= 65 THEN &quot;56–65&quot;&#13;&#10;ELSE &quot;66-80&quot;&#13;&#10;END' />
      </column>
      <column caption='Drop Out' datatype='integer' name='[Calculation_906067955681480705]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [nhif_migrated] = True THEN 1&#13;&#10;ELSE 0&#13;&#10;END' />
      </column>
      <column caption='Drop or Active' datatype='string' name='[Calculation_906067955684376578]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [nhif_migrated] = TRUE THEN &quot;Dropped Out&quot;&#13;&#10;ELSE &quot;Active&quot;&#13;&#10;END' />
      </column>
      <column caption='Calculation1' datatype='integer' name='[Calculation_906067955689365507]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [nhif_migrated] = True THEN 1&#13;&#10;ELSE 0&#13;&#10;END' />
      </column>
      <column caption='Approval Rate' datatype='real' name='[Calculation_906067955950080005]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(IF [claim_status] = &quot;Approved&quot; THEN 1 ELSE 0 END) / COUNT([claim_id]))* 100' />
      </column>
      <column caption='Rejection rate' datatype='real' name='[Calculation_906067955951341574]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(IF [claim_status] = &quot;Rejected&quot; THEN 1 ELSE 0 END) / COUNT([claim_id]))*100' />
      </column>
      <column caption='Approvals' datatype='integer' name='[Calculation_906067955955675143]' role='measure' type='quantitative'>
